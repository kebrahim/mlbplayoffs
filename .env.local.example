# Supabase project settings — Project Settings > API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authorizes Vercel Cron's calls to /api/sync/games (Vercel sends
# "Authorization: Bearer $CRON_SECRET" automatically once this is set).
# The crons are only a floor — most syncs are triggered by page loads when
# the data is stale, so a missing CRON_SECRET degrades freshness rather
# than breaking the app.
CRON_SECRET=
